# ============================================
# HavenKeep Monorepo .gitignore
# ============================================

# --- Dart / Flutter ---
**/dart_tool/
**/.packages
**/build/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/pubspec.lock
*.dart.js
*.js_
*.js.deps
*.js.map
.dart_tool/
.pub-cache/
.pub/

# --- Node.js ---
node_modules/
.pnpm-store/
pnpm-lock.yaml

# Compiled output / build artifacts
**/dist/
apps/partner-dashboard/.next/
apps/partner-dashboard/tsconfig.tsbuildinfo
apps/marketing/dist/

# --- Environment ---
# 4.10: backend / dashboard env files MUST stay out of git. The repo
# root `.env.staging.example` + `.env.example` are the only env files
# that should be tracked here. The mobile app intentionally tracks its
# own `apps/mobile/.env.{development,staging,production}` — those carry
# only public build-time config (API URL, public Firebase IDs that ship
# with every signed binary) and no secrets.
.env
.env.local
.env.*.local
.env.staging
.env.production

# --- IDE ---
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# --- OS ---
.DS_Store
Thumbs.db
*.log

# --- Build artifacts ---
*.apk
*.aab
*.ipa
*.app
*.dSYM.zip
*.dSYM

# --- Coverage ---
coverage/
*.lcov

# --- Generated ---
*.g.dart
*.freezed.dart
*.mocks.dart
secrets/

# --- Docker image tarballs ---
.docker-images/

# --- Mobile signing + Firebase configs (machine-local, never committed) ---
**/key.properties
**/upload-keystore.jks
**/google-services.json
**/GoogleService-Info.plist
**/lib/firebase_options.dart

# Generated Play Store listing assets (regenerable from brand sources)
apps/mobile/android/store-assets/

# Local docker-compose port overrides — gitignored
docker-compose.override.yml

# Store screenshots — generated by scripts/capture-store-screenshots.sh
apps/mobile/store-assets/screenshots/

# Local Claude Code session state (settings.local.json, scheduled task locks).
.claude/
