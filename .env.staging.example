# ============================================
# HavenKeep — Staging Environment Variables
# ============================================
# Copy this file to .env.staging and fill in all values.
# Run: cp .env.staging.example .env.staging
#
# ⚠️  Replace every CHANGE_ME before deploying!
# Generate secrets with: openssl rand -hex 32

# ============================================
# Application
# ============================================
NODE_ENV=staging
API_PORT=3000

# ============================================
# Domains (must match DNS + Caddy/nginx config)
# Caddy handles SSL on standard ports (80/443)
# ============================================
NEXT_PUBLIC_API_URL=https://api.staging.havenkeep.app
APP_BASE_URL=https://api.staging.havenkeep.app
FRONTEND_URL=https://staging.havenkeep.app
DASHBOARD_URL=https://partners.staging.havenkeep.app

# ============================================
# Database
# ============================================
POSTGRES_USER=havenkeep
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_MIN_16_CHARS
POSTGRES_DB=havenkeep

# ============================================
# Authentication & Security
# ============================================
# CRITICAL: Generate strong random strings!
# Use: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_MINIMUM_32_CHARACTERS_RANDOM_STRING
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_SECRET=CHANGE_ME_DIFFERENT_32_CHAR_RANDOM_STRING
REFRESH_TOKEN_EXPIRES_IN=7d

# ============================================
# Redis
# ============================================
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ============================================
# MinIO / Object Storage
# ============================================
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET
MINIO_BUCKET=havenkeep

# ============================================
# Stripe Payments
# ============================================
# Use TEST keys for staging (sk_test_...)
STRIPE_SECRET_KEY=sk_test_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME
STRIPE_PRICE_ID_PREMIUM=price_CHANGE_ME

# ============================================
# OAuth
# ============================================
# Google: this is the Web OAuth client ID from your Firebase project's
# linked Cloud project. Mobile clients pass it as serverClientId so the
# resulting idToken's `aud` matches what the backend verifies against.
GOOGLE_CLIENT_ID=
# Comma-separated list of additional `aud` values to accept (iOS native
# client, Android Web client, etc.). The backend verifies idTokens
# against the union of GOOGLE_CLIENT_ID + GOOGLE_AUDIENCES.
GOOGLE_AUDIENCES=

# Apple: bundle ID is for the native iOS flow; servicesIds is the
# comma-separated list of Apple Developer Services IDs used by the
# Android / web Sign-in-with-Apple flow. Set both staging + prod
# Services IDs here so a single endpoint validates either.
#   APPLE_SERVICES_IDS=com.flokou.havenkeep.signin.staging,com.flokou.havenkeep.signin
APPLE_BUNDLE_ID=
APPLE_SERVICES_IDS=

# ============================================
# Email (SendGrid)
# ============================================
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@havenkeep.com
SENDGRID_REPLY_TO_EMAIL=support@havenkeep.com

# ============================================
# OpenAI (AI features — receipt/email scanning)
# ============================================
OPENAI_API_KEY=

# ============================================
# RevenueCat (In-App Purchases)
# ============================================
REVENUECAT_SECRET_API_KEY=
REVENUECAT_WEBHOOK_SECRET=

# ============================================
# Firebase Cloud Messaging (push notifications)
# ============================================
# Service-account credentials downloaded from Firebase Console →
# Project settings → Service accounts → Firebase Admin SDK →
# Generate new private key. Paste the entire JSON on a single line
# (escape newlines in the private_key field as \n) OR use the _FILE
# variant to mount it as a Docker secret.
#
# If left empty, FCM push delivery is silently disabled (email
# fallback still works) — fine for early staging, NOT fine for prod.
FIREBASE_SERVICE_ACCOUNT_JSON=

# ============================================
# CORS — must list all staging HTTPS origins
# ============================================
CORS_ORIGINS=https://staging.havenkeep.app,https://partners.staging.havenkeep.app

# ============================================
# Monitoring
# ============================================
LOG_LEVEL=info
