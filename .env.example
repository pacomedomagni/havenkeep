# HavenKeep Environment Variables
#
# Copy this file to `.env` and fill in your values.
#
# 3.11: regenerated from the union of `process.env.*` reads in
# `apps/api/src/**/*.ts` and the `readSecret(...)` keys in
# `apps/api/src/config/index.ts`. Every variable the code reads should
# have an entry here so onboarding doesn't surface as "why is X
# undefined". Production deploys may swap any key for `KEY_FILE`
# (Docker secrets) — see `apps/api/src/config/index.ts` `readSecret`.

# ============================================
# Application
# ============================================
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:3001
# Number of trusted reverse-proxy hops in front of the API. 1 for the
# default Caddy + API setup; bump if you add a CDN / load balancer in
# front so Express picks the correct X-Forwarded-For entry.
TRUST_PROXY_HOPS=1

# Hour of day (UTC, 0-23) when the daily expiration / maintenance /
# warranty / partner-gift-expiry / audit-chain jobs fire.
NOTIFICATION_HOUR_UTC=14

# ============================================
# Database
# ============================================
DATABASE_URL=postgresql://havenkeep:CHANGE_ME@localhost:5432/havenkeep
DB_HOST=localhost
DB_PORT=5432
DB_NAME=havenkeep
DB_USER=havenkeep
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_MIN_16_CHARS
# Production deploys via `docker-compose.production.yml` set
# `POSTGRES_PASSWORD` instead of `DB_PASSWORD`. The config layer accepts
# either.
# POSTGRES_PASSWORD=CHANGE_ME

# Optional: path to a CA cert for verifying the Postgres TLS server
# cert when `DATABASE_URL` ends with `?sslmode=verify-full`.
# DB_SSL_CA_FILE=/etc/ssl/certs/postgres-ca.pem

# Database connection pool (optional)
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONNECTION_TIMEOUT=5000
DB_STATEMENT_TIMEOUT=30000

# Test-suite-only: targets a separate database so production data is
# never at risk. Default is `havenkeep_test`. Honoured by
# `apps/api/__tests__/setup.ts`.
TEST_DB_NAME=havenkeep_test

# ============================================
# Authentication & Security
# ============================================
# CRITICAL: generate strong random strings for production!
# Use: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_MINIMUM_32_CHARACTERS_RANDOM_STRING
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_SECRET=CHANGE_ME_DIFFERENT_32_CHAR_RANDOM_STRING
REFRESH_TOKEN_EXPIRES_IN=7d

# OAuth integration tokens encrypted at rest with AES-256-GCM. Required
# whenever the email scanner is enabled.
OAUTH_TOKEN_ENCRYPTION_SECRET=CHANGE_ME_32_BYTES_HEX
# Optional: set this to the *previous* value during a key rotation so
# in-flight rows can be re-encrypted before the old key is purged.
# OAUTH_TOKEN_ENCRYPTION_SECRET_LEGACY=

# Phrase the admin must type to confirm an audit-log purge. Defaults to
# the value in admin.ts; override locally for safer "rehearsal" runs.
# AUDIT_CLEANUP_CONFIRMATION_PHRASE=DELETE OLD AUDIT LOGS

# ============================================
# Redis
# ============================================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ============================================
# MinIO / Object Storage
# ============================================
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME_STRONG_SECRET
MINIO_BUCKET=havenkeep
# Optional: public-facing base URL for presigned download links when the
# bucket is fronted by a CDN. Defaults to the MINIO_ENDPOINT host.
# MINIO_PUBLIC_URL=https://files.havenkeep.com

# ============================================
# Stripe Payments
# ============================================
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_PREMIUM=price_...
# Set to `1` in non-production environments to allow Stripe sandbox
# webhook events through. Production hard-rejects these to avoid mixing
# test and live ledgers.
# STRIPE_ALLOW_SANDBOX=0

# ============================================
# OAuth — Sign-In
# ============================================
# Google: web OAuth client id from your Firebase project's linked Cloud
# project. Mobile clients pass it as `serverClientId` so the resulting
# id-token's `aud` matches what the backend verifies.
GOOGLE_CLIENT_ID=
# Optional comma-separated list of additional accepted audiences (e.g.
# the iOS-native client id).
GOOGLE_AUDIENCES=
# OAuth client secret for server-side code exchange (email scanner Gmail
# flow + RevenueCat receipt verification fallback).
GOOGLE_CLIENT_SECRET=

# Apple: bundleId is for the native iOS flow; SERVICES_IDS is the
# comma-separated list of Apple Developer Services IDs used by the
# Android / web Sign-in-with-Apple flow. Set both staging + prod
# Services IDs here so a single endpoint validates either.
APPLE_BUNDLE_ID=app.havenkeep.mobile
APPLE_SERVICES_IDS=app.havenkeep.mobile.signin.staging,app.havenkeep.mobile.signin

# Microsoft / Outlook (email scanner). The Azure AD app must be a
# confidential client (web), not "public client" — the API redeems the
# code with `MICROSOFT_CLIENT_SECRET` (no PKCE; see CLAUDE.md).
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# `common` (default) accepts personal + work accounts; set a tenant id
# to lock to a single Azure AD tenant.
MICROSOFT_TENANT=common

# Allowlist of OAuth redirect URI prefixes the API will accept on the
# scan endpoint. Comma-separated; defaults to the configured frontend +
# mobile app schemes.
# OAUTH_REDIRECT_URI_PREFIXES=havenkeep://oauth,https://app.havenkeep.com/oauth

# ============================================
# Email (SendGrid)
# ============================================
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@havenkeep.com
SENDGRID_REPLY_TO_EMAIL=support@havenkeep.com

# ============================================
# OpenAI (AI features)
# ============================================
OPENAI_API_KEY=
# Daily per-user OpenAI cost cap (in micro-dollars). Default is
# 100_000_000 (=$100/day) when unset; tune down for free-tier guards.
# OPENAI_DAILY_CAP_MICROS=100000000

# ============================================
# RevenueCat (In-App Purchases)
# ============================================
# Secret API key from RevenueCat dashboard (server-side only, NOT the
# public SDK key). Project Settings → API Keys → Secret API key.
REVENUECAT_SECRET_API_KEY=
# Shared secret for webhook signature validation. Set this in the
# RevenueCat dashboard under Integrations → Webhooks → Authorization.
REVENUECAT_WEBHOOK_SECRET=
# Set to `1` only in non-prod to accept sandbox webhook events.
# REVENUECAT_ALLOW_SANDBOX=0

# ============================================
# Firebase (Push Notifications via FCM)
# ============================================
# JSON string of Firebase service account credentials. If not set, FCM
# push delivery is silently disabled — the API still records the
# notification in `notification_history` and emails fall back as
# configured by the user's notification preferences.
FIREBASE_SERVICE_ACCOUNT_JSON=

# ============================================
# CORS
# ============================================
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:4321

# ============================================
# Monitoring
# ============================================
LOG_LEVEL=info

# ============================================
# Free Tier + Partner Program
# ============================================
FREE_TIER_ITEM_LIMIT=5
# JSON pricing map for partner subscription tiers.
PARTNER_TIER_PRICING={"basic":99,"premium":149,"platinum":249}

# ============================================
# Backups (production compose)
# ============================================
# Optional offsite backup target. When BACKUP_S3_BUCKET is unset the
# daily backup job skips the offsite step. See scripts/backup-database.sh.
# BACKUP_S3_BUCKET=havenkeep-backups
# BACKUP_S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
# BACKUP_S3_REGION=us-east-1
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
