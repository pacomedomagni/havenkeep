# HavenKeep Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# Application
# ============================================
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000

# ============================================
# Database
# ============================================
DATABASE_URL=postgresql://havenkeep:CHANGE_ME@localhost:5432/havenkeep
DB_HOST=localhost
DB_PORT=5432
DB_NAME=havenkeep
DB_USER=havenkeep
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_MIN_16_CHARS

# Database Connection Pool (Optional)
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONNECTION_TIMEOUT=5000
DB_STATEMENT_TIMEOUT=30000

# ============================================
# Authentication & Security
# ============================================
# CRITICAL: Generate strong random strings for production!
# Use: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_MINIMUM_32_CHARACTERS_RANDOM_STRING
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_SECRET=CHANGE_ME_DIFFERENT_32_CHAR_RANDOM_STRING
REFRESH_TOKEN_EXPIRES_IN=7d

# ============================================
# Redis
# ============================================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ============================================
# MinIO / Object Storage (Docker Compose)
# ============================================
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME_STRONG_SECRET
MINIO_BUCKET=havenkeep

# ============================================
# Stripe Payments
# ============================================
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_PREMIUM=price_...

# ============================================
# OAuth
# ============================================
GOOGLE_CLIENT_ID=
APPLE_BUNDLE_ID=

# ============================================
# Email (SendGrid)
# ============================================
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@havenkeep.com
SENDGRID_REPLY_TO_EMAIL=support@havenkeep.com

# ============================================
# CORS
# ============================================
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:4321

# ============================================
# Monitoring
# ============================================
LOG_LEVEL=info

# ============================================
# OpenAI (AI features)
# ============================================
OPENAI_API_KEY=

# ============================================
# RevenueCat (In-App Purchases)
# ============================================
# Secret API key from RevenueCat dashboard (server-side only, NOT the public SDK key)
# Get it from: https://app.revenuecat.com → Project Settings → API Keys → Secret API key
REVENUECAT_SECRET_API_KEY=
# Shared secret for webhook signature validation
# Set this in RevenueCat dashboard under Integrations → Webhooks → Authorization header
REVENUECAT_WEBHOOK_SECRET=

# ============================================
# Firebase (Push Notifications via FCM)
# ============================================
# JSON string of Firebase service account credentials.
# If not set, FCM push delivery is silently disabled.
FIREBASE_SERVICE_ACCOUNT_JSON=

# ============================================
# Application URLs
# ============================================
APP_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:3001

# ============================================
# Free Tier Limits
# ============================================
FREE_TIER_ITEM_LIMIT=5

# ============================================
# Partner Program
# ============================================
# JSON pricing map for partner subscription tiers
PARTNER_TIER_PRICING={"basic":99,"premium":149,"platinum":249}
