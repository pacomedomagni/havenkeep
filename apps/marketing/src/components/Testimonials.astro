---
// Audit Ch10-W081: the previous testimonials were fictional and presented
// as real customers \u2014 that's a fast path to a deceptive-advertising
// complaint. Replaced with illustrative scenarios labelled as such.
const scenarios = [
  {
    title: "The expiring fridge compressor",
    body: "A Samsung fridge compressor fails two weeks before warranty expiration. The customer paid $1,800 for the warranty in the first place \u2014 without a reminder, they'd have eaten the replacement cost personally.",
    saved: "Avoid: $1,800",
    icon: "\ud83e\uddca",
  },
  {
    title: "200 appliances, one tracker",
    body: "A property manager runs 14 rental units. Spreadsheets cover individual fridges, water heaters, and dishwashers \u2014 but expirations slide past unnoticed in busy quarters. HavenKeep surfaces them on a single timeline.",
    saved: "Catch: 3 claims/quarter",
    icon: "\ud83c\udfd8\ufe0f",
  },
  {
    title: "Accidental damage coverage you forgot you bought",
    body: "A laptop gets a juice spill. The receipt is in an email graveyard, and the AppleCare+ paperwork is somewhere on the kitchen counter. HavenKeep keeps both at hand so the claim takes minutes instead of hours.",
    saved: "Avoid: full repair cost",
    icon: "\ud83d\udca7",
  },
];
---

<section class="py-24 bg-gray-900">
  <div class="container">
    <div class="max-w-3xl mx-auto text-center mb-16 reveal">
      <span class="text-accent font-semibold text-sm uppercase tracking-wider">How it shows up</span>
      <h2 class="text-4xl md:text-5xl font-bold text-white mt-3 mb-4">
        Three scenarios HavenKeep was built for.
      </h2>
      <p class="text-xl text-gray-300">
        Illustrative examples — not actual customers. We'll publish real case studies after our first hundred verified saves.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-8 max-w-6xl mx-auto">
      {scenarios.map((s, i) => (
        <div class={`reveal reveal-delay-${i + 1} relative bg-gray-800 rounded-2xl p-8 border border-gray-700 hover:border-primary/50 transition-all duration-300`}>
          <div class="text-4xl mb-4" aria-hidden="true">{s.icon}</div>
          <h3 class="text-lg font-semibold text-white mb-2">{s.title}</h3>
          <p class="text-gray-300 leading-relaxed mb-6 text-sm">{s.body}</p>
          <p class="text-xs text-accent font-semibold">{s.saved}</p>
        </div>
      ))}
    </div>
  </div>
</section>
