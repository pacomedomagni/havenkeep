---
// Footer component
const currentYear = new Date().getFullYear();
---

<footer class="bg-gray-900 border-t border-gray-800">
  <div class="container py-12">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
      <!-- Brand -->
      <div class="col-span-2 md:col-span-1">
        <a href="/" class="flex items-center mb-4">
          <img src="/images/logo.svg" alt="HavenKeep" class="h-9" />
        </a>
        <p class="text-gray-400 text-sm">
          Stop losing money on<br />forgotten warranties.
        </p>
      </div>

      <!-- Product -->
      <div>
        <h3 class="font-semibold text-white mb-4">Product</h3>
        <ul class="space-y-2 text-sm">
          <li><a href="/features" class="text-gray-400 hover:text-white">Features</a></li>
          <li><a href="/pricing" class="text-gray-400 hover:text-white">Pricing</a></li>
          <li><a href="/partners" class="text-gray-400 hover:text-white">Partners</a></li>
          <li><a href="/security" class="text-gray-400 hover:text-white">Security</a></li>
          <li><a href="/roadmap" class="text-gray-400 hover:text-white">Roadmap</a></li>
        </ul>
      </div>

      <!-- Company -->
      <div>
        <h3 class="font-semibold text-white mb-4">Company</h3>
        <ul class="space-y-2 text-sm">
          <li><a href="/blog" class="text-gray-400 hover:text-white">Blog</a></li>
          <li><a href="/contact" class="text-gray-400 hover:text-white">Contact</a></li>
          <li><a href="/careers" class="text-gray-400 hover:text-white">Careers</a></li>
        </ul>
      </div>

      <!-- Legal -->
      <div>
        <h3 class="font-semibold text-white mb-4">Legal</h3>
        <ul class="space-y-2 text-sm">
          <li><a href="/legal/privacy" class="text-gray-400 hover:text-white">Privacy</a></li>
          <li><a href="/legal/terms" class="text-gray-400 hover:text-white">Terms</a></li>
          <li><a href="/legal/delete-account" class="text-gray-400 hover:text-white">Delete account</a></li>
          <li><a href="/cookies" class="text-gray-400 hover:text-white">Cookies</a></li>
          <li><a href="/licenses" class="text-gray-400 hover:text-white">Licenses</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-12 pt-8 border-t border-gray-800">
      <div class="flex flex-col md:flex-row justify-between items-center space-y-4 md:space-y-0">
        <div class="flex flex-col sm:flex-row items-center gap-3 sm:gap-4">
          <p class="text-sm text-gray-400">
            © {currentYear} HavenKeep. All rights reserved.
          </p>
          <a
            href="https://flokou.com"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-xs text-gray-500 hover:text-gray-300 transition-colors"
          >
            <span>Powered by</span>
            <span class="inline-flex items-baseline">
              <span class="font-semibold tracking-tight">flokou</span>
              <span class="w-1 h-1 ml-0.5 rounded-full bg-[#FF5A36] self-end mb-0.5"></span>
            </span>
          </a>
        </div>

      </div>
    </div>
  </div>
</footer>
