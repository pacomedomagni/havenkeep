---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
}

const { title, description = 'Americans lose $16 billion yearly on forgotten warranties. HavenKeep tracks expiration dates, stores receipts, and reminds you before it\'s too late. Free to start.', canonicalPath } = Astro.props;
const canonicalUrl = canonicalPath ? `https://havenkeep.com${canonicalPath}` : `https://havenkeep.com${Astro.url.pathname}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/images/logo-icon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title} | HavenKeep</title>
    <meta name="title" content={`${title} | HavenKeep`} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={`${title} | HavenKeep`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://havenkeep.com/images/logo.svg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={`${title} | HavenKeep`} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content="https://havenkeep.com/images/logo.svg" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  </head>
  <body class="bg-gray-900 text-gray-100">
    <slot />
  </body>
</html>
