---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';

// Partner-dashboard signup URL. Defaults to the relative `/signup` so the
// link works under any reverse-proxy layout that fronts both apps from
// the same origin (or when Caddy splits them by Host header on shared
// public DNS). Override with PUBLIC_PARTNER_DASHBOARD_URL when the
// dashboard lives on its own subdomain (e.g. https://partners.havenkeep.com).
const partnerDashboardSignup =
  (import.meta.env.PUBLIC_PARTNER_DASHBOARD_URL as string | undefined)?.replace(/\/$/, '') ?? '';
const signupHref = `${partnerDashboardSignup}/signup`;
---

<Layout
  title="Partners"
  description="Realtors, contractors, builders, and property managers — give your clients six months of HavenKeep Premium at closing. Free for them, free for you."
  canonicalPath="/partners"
>
  <Navigation />
  <main>
    <!-- Hero -->
    <section class="pt-32 pb-20 bg-gradient-to-b from-gray-900 to-gray-800">
      <div class="container">
        <div class="max-w-3xl mx-auto text-center">
          <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-accent/10 border border-accent/30 mb-6">
            <svg class="w-4 h-4 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4" />
            </svg>
            <span class="text-sm font-medium text-accent">Partner Program</span>
          </div>
          <h1 class="text-5xl md:text-6xl font-bold text-white mb-6">
            A closing gift<br />
            <span class="bg-gradient-to-r from-primary to-accent bg-clip-text text-transparent">that actually gets used.</span>
          </h1>
          <p class="text-xl text-gray-300 mb-10 leading-relaxed">
            Send your clients <strong class="text-white">six months of HavenKeep Premium</strong> when they get the keys. They get an app that tracks every warranty, receipt, and maintenance reminder in the new home. You get to be the realtor who gave them something useful.
          </p>
          <p class="text-xl text-gray-300 mb-10 leading-relaxed">
            <strong class="text-white">Free for the homebuyer. Free for you.</strong> No card, no commission, no contract.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a
              href={signupHref}
              class="px-8 py-3 bg-primary hover:bg-primary-light text-white rounded-lg font-medium transition-colors"
            >
              Sign up — it's free
            </a>
            <a
              href="#how-it-works"
              class="px-8 py-3 border border-gray-600 hover:border-gray-400 text-white rounded-lg font-medium transition-colors"
            >
              How it works
            </a>
          </div>
          <p class="text-sm text-gray-400 mt-6">
            Email + password. No license verification, no Stripe onboarding, no waiting room.
          </p>
        </div>
      </div>
    </section>

    <!-- Who it's for -->
    <section class="py-20 bg-gray-900">
      <div class="container">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-bold text-white text-center mb-12">
            Built for the people who hand over the keys.
          </h2>
          <div class="grid md:grid-cols-2 gap-6">
            <div class="p-6 bg-gray-800 rounded-xl border border-gray-700">
              <h3 class="text-xl font-semibold text-white mb-2">Realtors</h3>
              <p class="text-gray-300">
                Closing gifts are a hassle. A bottle of wine gets drunk in a week, a fruit basket goes off in three days. HavenKeep is six months of "your realtor was thinking about you" every time the homebuyer opens the app to log a new appliance or chase a warranty claim.
              </p>
            </div>
            <div class="p-6 bg-gray-800 rounded-xl border border-gray-700">
              <h3 class="text-xl font-semibold text-white mb-2">Builders</h3>
              <p class="text-gray-300">
                You hand over a house with sixty appliances, ten warranties, and a binder of paperwork the homebuyer will lose in a week. Send them HavenKeep instead — they'll thank you when the dishwasher dies at month four.
              </p>
            </div>
            <div class="p-6 bg-gray-800 rounded-xl border border-gray-700">
              <h3 class="text-xl font-semibold text-white mb-2">Contractors</h3>
              <p class="text-gray-300">
                Finish a renovation, hand over the warranty cards, send HavenKeep with the closeout package. The homeowner now has a record of every fixture you installed and every warranty you stand behind, in one place.
              </p>
            </div>
            <div class="p-6 bg-gray-800 rounded-xl border border-gray-700">
              <h3 class="text-xl font-semibold text-white mb-2">Property managers</h3>
              <p class="text-gray-300">
                New tenant move-in. Hand them HavenKeep — they track their own stuff, you stop fielding "where's the receipt for the microwave you said you'd cover" texts at 9pm.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- How it works -->
    <section id="how-it-works" class="py-20 bg-gray-800">
      <div class="container">
        <div class="max-w-3xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-bold text-white text-center mb-4">
            How it works
          </h2>
          <p class="text-lg text-gray-300 text-center mb-12">
            Three steps. Under two minutes per gift.
          </p>

          <div class="space-y-8">
            <div class="flex gap-6">
              <div class="flex-shrink-0 w-12 h-12 rounded-full bg-primary/20 border border-primary flex items-center justify-center text-primary font-bold text-lg">
                1
              </div>
              <div>
                <h3 class="text-xl font-semibold text-white mb-2">Sign up</h3>
                <p class="text-gray-300">
                  Email, password, your name, your company name. That's it. You land on the partner dashboard ready to send your first gift.
                </p>
              </div>
            </div>

            <div class="flex gap-6">
              <div class="flex-shrink-0 w-12 h-12 rounded-full bg-primary/20 border border-primary flex items-center justify-center text-primary font-bold text-lg">
                2
              </div>
              <div>
                <h3 class="text-xl font-semibold text-white mb-2">Create a gift</h3>
                <p class="text-gray-300">
                  Type the homebuyer's name and email. Optionally add a closing date or a personal note. Hit send. HavenKeep emails them a branded activation link the moment you click.
                </p>
              </div>
            </div>

            <div class="flex gap-6">
              <div class="flex-shrink-0 w-12 h-12 rounded-full bg-primary/20 border border-primary flex items-center justify-center text-primary font-bold text-lg">
                3
              </div>
              <div>
                <h3 class="text-xl font-semibold text-white mb-2">They redeem</h3>
                <p class="text-gray-300">
                  They tap the link, install the app, and get six months of HavenKeep Premium. The email has your company name, your brand color, your logo — and your custom note if you wrote one. You see when they activated it from your dashboard.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- What's in it for you -->
    <section class="py-20 bg-gray-900">
      <div class="container">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-bold text-white text-center mb-12">
            What you actually get.
          </h2>
          <div class="grid md:grid-cols-2 gap-6">
            <div class="p-6 bg-gray-800 rounded-xl border border-gray-700">
              <h3 class="text-lg font-semibold text-white mb-2">A gift you don't have to think about</h3>
              <p class="text-gray-300">
                No shopping, no shipping, no shelf life. Type a name + email, click send. Two minutes per closing, and your client opens it the same day.
              </p>
            </div>
            <div class="p-6 bg-gray-800 rounded-xl border border-gray-700">
              <h3 class="text-lg font-semibold text-white mb-2">Your name on every email</h3>
              <p class="text-gray-300">
                Your company name, your brand color, your logo. The homebuyer doesn't see "from HavenKeep" — they see "from you."
              </p>
            </div>
            <div class="p-6 bg-gray-800 rounded-xl border border-gray-700">
              <h3 class="text-lg font-semibold text-white mb-2">A reason for the next conversation</h3>
              <p class="text-gray-300">
                Six months from now they'll remember you sent this — when a warranty claim works because the receipt was in HavenKeep, when the HVAC reminder catches a $400 repair before it becomes $4,000.
              </p>
            </div>
            <div class="p-6 bg-gray-800 rounded-xl border border-gray-700">
              <h3 class="text-lg font-semibold text-white mb-2">Zero downside</h3>
              <p class="text-gray-300">
                Free. No card on file. No "trial that converts to paid." Send one, send fifty — your cost is the same.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-20 bg-gray-800">
      <div class="container">
        <div class="max-w-3xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-bold text-white text-center mb-12">
            Questions
          </h2>
          <div class="space-y-6">
            <details class="group p-6 bg-gray-900 rounded-xl border border-gray-700 open:border-primary/40">
              <summary class="cursor-pointer flex items-center justify-between text-white font-semibold">
                <span>What's the catch?</span>
                <span class="text-gray-400 group-open:rotate-180 transition-transform">▾</span>
              </summary>
              <p class="text-gray-300 mt-4 leading-relaxed">
                None. We give your client six months of HavenKeep Premium for free because we want them to fall in love with the product. If they stay subscribed after six months at $2.99/mo or $24/yr, we make money. If they don't, we don't. You're the distribution channel.
              </p>
            </details>

            <details class="group p-6 bg-gray-900 rounded-xl border border-gray-700">
              <summary class="cursor-pointer flex items-center justify-between text-white font-semibold">
                <span>Do I have to be a licensed realtor?</span>
                <span class="text-gray-400 group-open:rotate-180 transition-transform">▾</span>
              </summary>
              <p class="text-gray-300 mt-4 leading-relaxed">
                No. The program is for anyone who hands keys to a homebuyer — realtors, builders, contractors, property managers, the friend who renovated their cousin's kitchen. Sign up takes a minute and there's no verification step.
              </p>
            </details>

            <details class="group p-6 bg-gray-900 rounded-xl border border-gray-700">
              <summary class="cursor-pointer flex items-center justify-between text-white font-semibold">
                <span>How does the homebuyer redeem?</span>
                <span class="text-gray-400 group-open:rotate-180 transition-transform">▾</span>
              </summary>
              <p class="text-gray-300 mt-4 leading-relaxed">
                They get an email with a tap-to-redeem link. On a phone it opens HavenKeep directly to the activation screen with the code pre-filled. They install the app, sign up, and they're on Premium. The whole flow is under a minute.
              </p>
            </details>

            <details class="group p-6 bg-gray-900 rounded-xl border border-gray-700">
              <summary class="cursor-pointer flex items-center justify-between text-white font-semibold">
                <span>What if my client already pays for HavenKeep?</span>
                <span class="text-gray-400 group-open:rotate-180 transition-transform">▾</span>
              </summary>
              <p class="text-gray-300 mt-4 leading-relaxed">
                The six months stack on top of whatever they already have. If they're a year into Premium, redeeming the gift extends their expiry by six months. Nothing gets overwritten.
              </p>
            </details>

            <details class="group p-6 bg-gray-900 rounded-xl border border-gray-700">
              <summary class="cursor-pointer flex items-center justify-between text-white font-semibold">
                <span>How many gifts can I send?</span>
                <span class="text-gray-400 group-open:rotate-180 transition-transform">▾</span>
              </summary>
              <p class="text-gray-300 mt-4 leading-relaxed">
                As many as you have closings. We may add a soft cap on brand-new accounts to slow down spam, but if you're closing real deals you'll never see it. If you're sending hundreds of gifts a month, email <a href="mailto:partners@havenkeep.com" class="text-primary hover:text-primary-light underline">partners@havenkeep.com</a> first so we can pre-clear your volume.
              </p>
            </details>

            <details class="group p-6 bg-gray-900 rounded-xl border border-gray-700">
              <summary class="cursor-pointer flex items-center justify-between text-white font-semibold">
                <span>Can I customize how the gift email looks?</span>
                <span class="text-gray-400 group-open:rotate-180 transition-transform">▾</span>
              </summary>
              <p class="text-gray-300 mt-4 leading-relaxed">
                Yes. From the dashboard's settings screen you can set your company name, your brand color, and a logo URL — those show up on every gift email you send. You can also write a one-time personal note per gift in the create-gift form.
              </p>
            </details>

            <details class="group p-6 bg-gray-900 rounded-xl border border-gray-700">
              <summary class="cursor-pointer flex items-center justify-between text-white font-semibold">
                <span>What does the homebuyer get after the six months?</span>
                <span class="text-gray-400 group-open:rotate-180 transition-transform">▾</span>
              </summary>
              <p class="text-gray-300 mt-4 leading-relaxed">
                Their data stays. They drop to the free tier (which still tracks up to 5 items) and can subscribe any time to keep Premium features — $2.99/mo or $24/yr. Nothing gets deleted at the six-month mark.
              </p>
            </details>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-20 bg-gradient-to-b from-gray-900 to-gray-800">
      <div class="container">
        <div class="max-w-2xl mx-auto text-center">
          <h2 class="text-3xl md:text-4xl font-bold text-white mb-6">
            Send your first one this afternoon.
          </h2>
          <p class="text-lg text-gray-300 mb-8 leading-relaxed">
            Sign up, customize your gift email, and have something in your client's inbox before they finish unpacking.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a
              href={signupHref}
              class="px-8 py-3 bg-primary hover:bg-primary-light text-white rounded-lg font-medium transition-colors"
            >
              Sign up — it's free
            </a>
            <a
              href="mailto:partners@havenkeep.com"
              class="px-8 py-3 border border-gray-600 hover:border-gray-400 text-white rounded-lg font-medium transition-colors"
            >
              Talk to us first
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
