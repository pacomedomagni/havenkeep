---
// Audit Ch10-W093, W094, W105: blog posts are now sourced from a content
// collection (`src/content/blog`) so the slug matches the filename and the
// publish date is a real `Date` (rendered with <time datetime>). Adding a
// post is now a frontmatter-only operation.
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';

const collectionEntries = await getCollection('blog');
const posts = collectionEntries
  .map((entry) => ({
    title: entry.data.title,
    excerpt: entry.data.excerpt,
    date: entry.data.date,
    category: entry.data.category,
    slug: entry.slug,
    image: entry.data.image,
  }))
  .sort((a, b) => b.date.getTime() - a.date.getTime());

const dateFormatter = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const featured = posts[0];
const remainder = posts.slice(1);
---

<Layout title="Blog" description="Tips, guides, and insights about warranty tracking, consumer rights, and protecting your purchases">
  <Navigation />
  <main>
    <!-- Hero Section -->
    <section class="pt-32 pb-20 bg-gradient-to-b from-gray-900 to-gray-800">
      <div class="container">
        <div class="max-w-4xl mx-auto text-center">
          <h1 class="text-5xl md:text-6xl font-bold text-white mb-6">
            HavenKeep Blog
          </h1>
          <p class="text-xl md:text-2xl text-gray-300">
            Tips, guides, and insights to help you protect your purchases
          </p>
        </div>
      </div>
    </section>

    {featured && (
      <section class="py-12 bg-gray-900">
        <div class="container">
          <div class="max-w-5xl mx-auto">
            <div class="bg-gradient-to-br from-primary to-secondary rounded-2xl p-8 md:p-12">
              <div class="flex items-center gap-3 mb-4">
                <span class="bg-white/20 text-white text-sm font-semibold px-3 py-1 rounded-full">Featured</span>
                <time datetime={featured.date.toISOString()} class="text-white/80 text-sm">
                  {dateFormatter.format(featured.date)}
                </time>
              </div>
              <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">
                {featured.title}
              </h2>
              <p class="text-white/90 text-lg mb-6">
                {featured.excerpt}
              </p>
              <a href={`/blog/${featured.slug}`} class="inline-block bg-white text-primary hover:bg-gray-100 font-semibold py-3 px-6 rounded-lg transition-colors duration-200">
                Read Article
              </a>
            </div>
          </div>
        </div>
      </section>
    )}

    <!-- All Posts -->
    <section class="py-20 bg-gray-900">
      <div class="container">
        <div class="max-w-5xl mx-auto">
          <h2 class="text-3xl font-bold text-white mb-8">Latest Articles</h2>

          <div class="grid md:grid-cols-2 gap-8">
            {remainder.map((post) => (
              <article class="border border-gray-700 rounded-xl p-6 bg-gray-800 hover:border-primary transition-colors duration-200">
                <div class="text-5xl mb-4" aria-hidden="true">{post.image}</div>
                <div class="flex items-center gap-3 mb-3">
                  <span class="text-primary text-sm font-semibold">{post.category}</span>
                  <time datetime={post.date.toISOString()} class="text-gray-500 text-sm">
                    {dateFormatter.format(post.date)}
                  </time>
                </div>
                <h3 class="text-xl font-bold text-white mb-3">
                  {post.title}
                </h3>
                <p class="text-gray-400 mb-4">
                  {post.excerpt}
                </p>
                <a href={`/blog/${post.slug}`} class="text-primary hover:text-secondary font-semibold inline-flex items-center gap-2">
                  Read more
                  <svg class="w-4 h-4" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              </article>
            ))}
          </div>

          <!-- Newsletter Signup -->
          <div class="mt-16 border border-gray-700 rounded-xl p-8 bg-gray-800 text-center">
            <h3 class="text-2xl font-bold text-white mb-4">
              Never miss an update
            </h3>
            <p class="text-gray-300 mb-6">
              Get the latest warranty tips and product updates delivered to your inbox
            </p>
            <form id="newsletter-form" class="max-w-md mx-auto flex flex-col gap-3">
              <div class="flex gap-3">
                <label for="newsletter-email" class="sr-only">Email address</label>
                <input
                  type="email"
                  id="newsletter-email"
                  placeholder="Enter your email"
                  class="flex-1 px-4 py-3 rounded-lg bg-gray-900 border border-gray-700 text-white placeholder-gray-500 focus:outline-none focus:border-primary"
                  required
                  autocomplete="email"
                />
                <button
                  type="submit"
                  id="newsletter-submit"
                  class="bg-primary hover:bg-secondary text-white font-semibold px-6 py-3 rounded-lg transition-colors duration-200 disabled:opacity-60"
                >
                  Subscribe
                </button>
              </div>
              <!-- Honeypot — visually hidden + aria-hidden + autocomplete=off
                   so real users never fill it. The newsletter API is also
                   protected by `newsletterRateLimiter` (5 / hour / IP). -->
              <div class="absolute left-[-10000px] top-auto w-px h-px overflow-hidden" aria-hidden="true">
                <label for="newsletter-website">Website (leave blank)</label>
                <input
                  type="text"
                  id="newsletter-website"
                  name="newsletter-website"
                  tabindex="-1"
                  autocomplete="off"
                />
              </div>
            </form>
            <p id="newsletter-success" class="hidden text-accent font-semibold mt-4" role="status">Thanks for subscribing! You'll receive our latest updates.</p>
            <p id="newsletter-error" class="hidden text-red-400 font-semibold mt-4" role="alert"></p>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  // Audit Ch10-W069, W071, W073: same-origin POST to the API behind the
  // marketing edge proxy, success state stays sticky until reload (no
  // auto-reset that would encourage duplicate submits). Bot defence is
  // the honeypot input above + the API-side `newsletterRateLimiter`.
  const form = document.getElementById('newsletter-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('newsletter-submit') as HTMLButtonElement | null;
  const successMsg = document.getElementById('newsletter-success');
  const errorMsg = document.getElementById('newsletter-error');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!submitBtn || submitBtn.disabled) return;

    const email = (document.getElementById('newsletter-email') as HTMLInputElement).value.trim();
    // Honeypot — drop client-side too so a tripped bot doesn't even hit
    // the API. The server still rejects independently in case the form
    // is submitted programmatically.
    const honeypot = (document.getElementById('newsletter-website') as HTMLInputElement | null)?.value ?? '';
    if (honeypot.trim().length > 0) {
      // Pretend success so a probing bot can't tell whether it was caught.
      form.classList.add('hidden');
      successMsg?.classList.remove('hidden');
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = 'Subscribing...';
    errorMsg?.classList.add('hidden');

    const apiUrl = (import.meta.env.PUBLIC_API_URL as string | undefined) ?? '';
    try {
      const response = await fetch(`${apiUrl}/api/v1/newsletter/subscribe`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({ email }),
        credentials: 'omit',
      });

      if (!response.ok) {
        throw new Error(String(response.status));
      }

      form.classList.add('hidden');
      successMsg?.classList.remove('hidden');
    } catch {
      if (errorMsg) {
        errorMsg.textContent = 'Subscription failed. Please try again in a moment.';
        errorMsg.classList.remove('hidden');
      }
      submitBtn.disabled = false;
      submitBtn.textContent = 'Subscribe';
    }
  });
</script>
