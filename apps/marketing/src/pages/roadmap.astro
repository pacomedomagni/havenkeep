---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';

// Honest planning bands. We don't commit to specific quarters because
// we're a small team — but we'll move items between bands as work lands.
const roadmapItems = [
  {
    quarter: 'Working on next',
    status: 'In Progress',
    items: [
      { title: 'Data export', description: 'Download a ZIP of items, warranties, claims, and document URLs as CSV + manifest. Honors the data-portability claim in our privacy policy', completed: false },
      { title: 'Telemetry opt-out', description: 'Settings → Privacy → Telemetry switch to suppress per-user feature-usage counters', completed: false },
      { title: 'Email scanner reliability', description: 'Pagination across > 50 matched messages, DKIM domain-alignment + DMARC enforcement, scope-downgrade auto-revoke', completed: false },
    ]
  },
  {
    quarter: 'Next up',
    status: 'Planned',
    items: [
      { title: 'Household sharing', description: 'A second phone on the same household can see the same warranties — without account merging', completed: false },
      { title: 'Warranty offer surfacing', description: 'When you add an item, surface the manufacturer\'s extended-warranty option (cost + duration) so you can make an informed call', completed: false },
      { title: 'Web app', description: 'Read-only web companion so you can pull receipts from a laptop when a claim comes up', completed: false },
    ]
  },
  {
    quarter: 'Considering',
    status: 'Under Consideration',
    items: [
      { title: 'OCR for handwritten receipts', description: 'Currently we extract printed receipts well; handwritten / faded thermal paper is hit-or-miss', completed: false },
      { title: 'International support', description: 'Multi-currency, locale-aware date formats, EU VAT receipts. Will need legal review per region', completed: false },
      { title: 'Public API', description: 'Once we have a stable feature set, a documented API for partner integrations (insurance, retailer order systems)', completed: false },
    ]
  },
];

const recentlyCompleted = [
  { title: 'Dark mode by default', description: 'The whole app ships in a dark theme tuned for low-light receipt photography', date: 'Built in' },
  { title: 'Barcode scanner', description: 'Snap a UPC and the item, brand, and category land prefilled', date: 'Shipped' },
  { title: 'Smart reminders', description: 'Push and email alerts the configurable number of days before expiry', date: 'Shipped' },
  { title: 'Partner closing gifts', description: 'Realtors send a Premium gift; clients claim it at the URL on the card', date: 'Shipped' },
];
---

<Layout title="Roadmap" description="See what we're building next at HavenKeep. Vote on features and help shape the future of warranty tracking">
  <Navigation />
  <main>
    <!-- Hero Section -->
    <section class="pt-32 pb-20 bg-gradient-to-b from-gray-900 to-gray-800">
      <div class="container">
        <div class="max-w-4xl mx-auto text-center">
          <h1 class="text-5xl md:text-6xl font-bold text-white mb-6">
            Product Roadmap
          </h1>
          <p class="text-xl md:text-2xl text-gray-300 mb-8">
            See what we're building and help shape the future of HavenKeep
          </p>
          <a href="mailto:feedback@havenkeep.com" class="inline-block bg-primary hover:bg-secondary text-white font-semibold py-3 px-6 rounded-lg transition-colors duration-200">
            Suggest a Feature
          </a>
        </div>
      </div>
    </section>

    <!-- Recently Completed -->
    <section class="py-12 bg-gray-900">
      <div class="container">
        <div class="max-w-5xl mx-auto">
          <h2 class="text-3xl font-bold text-white mb-8">Recently Completed ✨</h2>
          <div class="grid md:grid-cols-2 gap-6">
            {recentlyCompleted.map((item) => (
              <div class="border border-accent/30 rounded-lg p-6 bg-accent/5">
                <div class="flex items-start gap-3 mb-3">
                  <svg class="w-6 h-6 text-accent flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                  </svg>
                  <div class="flex-1">
                    <h3 class="text-lg font-semibold text-white mb-1">{item.title}</h3>
                    <p class="text-gray-400 text-sm mb-2">{item.description}</p>
                    <span class="text-accent text-xs font-medium">{item.date}</span>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Roadmap Timeline -->
    <section class="py-20 bg-gray-800">
      <div class="container">
        <div class="max-w-5xl mx-auto">
          <h2 class="text-3xl font-bold text-white mb-12">What's Next</h2>
          
          <div class="space-y-12">
            {roadmapItems.map((quarter, index) => (
              <div>
                <div class="flex items-center gap-4 mb-6">
                  <h3 class="text-2xl font-bold text-white">{quarter.quarter}</h3>
                  <span class={`px-3 py-1 rounded-full text-sm font-semibold ${
                    quarter.status === 'In Progress' ? 'bg-primary/20 text-primary' :
                    quarter.status === 'Planned' ? 'bg-secondary/20 text-secondary' :
                    'bg-gray-700 text-gray-300'
                  }`}>
                    {quarter.status}
                  </span>
                </div>
                
                <div class="space-y-4">
                  {quarter.items.map((item) => (
                    <div class="border border-gray-700 rounded-lg p-6 bg-gray-900 hover:border-primary/50 transition-colors">
                      <h4 class="text-xl font-semibold text-white mb-2">{item.title}</h4>
                      <p class="text-gray-400">{item.description}</p>
                    </div>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Feature Voting CTA -->
    <section class="py-20 bg-gray-900">
      <div class="container">
        <div class="max-w-3xl mx-auto">
          <div class="border border-gray-700 rounded-2xl p-8 md:p-12 bg-gray-800 text-center">
            <h2 class="text-3xl font-bold text-white mb-4">
              Your Voice Matters
            </h2>
            <p class="text-gray-300 text-lg mb-8">
              Our roadmap is shaped by your feedback. Have an idea for a feature? We'd love to hear it!
            </p>
            <div class="flex justify-center">
              <a href="mailto:feedback@havenkeep.com" class="bg-primary hover:bg-secondary text-white font-semibold py-4 px-8 rounded-lg transition-colors duration-200">
                Submit Feature Request
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Transparency Note -->
    <section class="py-12 bg-gray-800">
      <div class="container">
        <div class="max-w-4xl mx-auto text-center">
          <p class="text-gray-400">
            This roadmap represents our current plans and priorities. Timelines and features may change based on customer feedback, technical considerations, and business needs. We'll keep this page updated as plans evolve.
          </p>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
