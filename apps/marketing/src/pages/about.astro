---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="About" description="Learn about HavenKeep's mission to help homeowners track warranties, manage maintenance, and protect their home investments.">
  <Navigation />
  <main>
    <!-- Hero Section -->
    <section class="pt-32 pb-20 bg-gradient-to-b from-gray-900 to-gray-800">
      <div class="container">
        <div class="max-w-4xl mx-auto text-center">
          <div class="w-20 h-20 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-6">
            <svg class="w-10 h-10 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
            </svg>
          </div>
          <h1 class="text-5xl md:text-6xl font-bold text-white mb-6">
            About HavenKeep
          </h1>
          <p class="text-xl md:text-2xl text-gray-300">
            We believe every homeowner deserves the tools to protect their biggest investment &mdash; without the headache.
          </p>
        </div>
      </div>
    </section>

    <!-- Mission Section -->
    <section class="py-20 bg-gray-900">
      <div class="container">
        <div class="max-w-4xl mx-auto">
          <div class="grid md:grid-cols-2 gap-12 items-center">
            <div>
              <h2 class="text-3xl font-bold text-white mb-6">Our Mission</h2>
              <div class="space-y-4 text-gray-300">
                <p class="text-lg">
                  Americans lose over <strong class="text-white">$16 billion each year</strong> on forgotten warranties alone. Appliances break, roofs leak, and HVAC systems fail &mdash; often while still under warranty. The problem isn't that warranties don't work. It's that life gets busy and people forget.
                </p>
                <p class="text-lg">
                  HavenKeep exists to solve that. We help homeowners stay ahead of expiring warranties, keep up with maintenance schedules, and store everything they need in one secure place &mdash; so when something goes wrong, they're ready.
                </p>
              </div>
            </div>
            <div class="bg-gray-800 border border-gray-700 rounded-2xl p-8">
              <div class="space-y-6">
                <div class="flex items-center gap-4">
                  <div class="w-12 h-12 bg-accent/10 rounded-full flex items-center justify-center flex-shrink-0">
                    <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                  </div>
                  <div>
                    <p class="text-3xl font-bold text-white">$16B</p>
                    <p class="text-gray-400 text-sm">Lost annually to forgotten warranties</p>
                  </div>
                </div>
                <div class="flex items-center gap-4">
                  <div class="w-12 h-12 bg-accent/10 rounded-full flex items-center justify-center flex-shrink-0">
                    <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                  </div>
                  <div>
                    <p class="text-3xl font-bold text-white">$340</p>
                    <p class="text-gray-400 text-sm">Average household waste per year</p>
                  </div>
                </div>
                <div class="flex items-center gap-4">
                  <div class="w-12 h-12 bg-accent/10 rounded-full flex items-center justify-center flex-shrink-0">
                    <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
                    </svg>
                  </div>
                  <div>
                    <p class="text-3xl font-bold text-white">14x</p>
                    <p class="text-gray-400 text-sm">Return on a Premium subscription</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- What We Do Section -->
    <section class="py-20 bg-gray-800">
      <div class="container">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-3xl font-bold text-white text-center mb-12">What We Do</h2>
          <div class="grid md:grid-cols-3 gap-8">
            <div class="bg-gray-900 border border-gray-700 rounded-xl p-6 text-center">
              <div class="w-14 h-14 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
                <svg class="w-7 h-7 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
              </div>
              <h3 class="text-xl font-semibold text-white mb-3">Track Warranties</h3>
              <p class="text-gray-400">
                Never lose track of a warranty again. We store your coverage details and alert you before they expire, so you can file claims on time.
              </p>
            </div>
            <div class="bg-gray-900 border border-gray-700 rounded-xl p-6 text-center">
              <div class="w-14 h-14 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
                <svg class="w-7 h-7 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                </svg>
              </div>
              <h3 class="text-xl font-semibold text-white mb-3">Manage Maintenance</h3>
              <p class="text-gray-400">
                Stay on top of routine maintenance for every system in your home &mdash; from HVAC filters to roof inspections &mdash; with smart reminders.
              </p>
            </div>
            <div class="bg-gray-900 border border-gray-700 rounded-xl p-6 text-center">
              <div class="w-14 h-14 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
                <svg class="w-7 h-7 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
              </div>
              <h3 class="text-xl font-semibold text-white mb-3">Store Documents</h3>
              <p class="text-gray-400">
                Receipts, manuals, contracts, and more &mdash; organized in one secure place. Snap a photo or upload a PDF and let our AI do the rest.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Our Values Section -->
    <section class="py-20 bg-gray-900">
      <div class="container">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-3xl font-bold text-white text-center mb-12">Our Values</h2>
          <div class="space-y-8">
            <div class="flex items-start gap-6">
              <div class="w-12 h-12 bg-accent/10 rounded-full flex items-center justify-center flex-shrink-0 mt-1">
                <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                </svg>
              </div>
              <div>
                <h3 class="text-xl font-semibold text-white mb-2">Transparency</h3>
                <p class="text-gray-300 text-lg">
                  No hidden fees, no surprise charges, no dark patterns. Our pricing is simple, our policies are clear, and we tell you exactly what we do with your data.
                </p>
              </div>
            </div>
            <div class="flex items-start gap-6">
              <div class="w-12 h-12 bg-accent/10 rounded-full flex items-center justify-center flex-shrink-0 mt-1">
                <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                </svg>
              </div>
              <div>
                <h3 class="text-xl font-semibold text-white mb-2">Security First</h3>
                <p class="text-gray-300 text-lg">
                  Your receipts and warranty documents contain sensitive information. We use AES-256 encryption at rest, TLS 1.3 in transit, and never sell your data to third parties.
                </p>
              </div>
            </div>
            <div class="flex items-start gap-6">
              <div class="w-12 h-12 bg-accent/10 rounded-full flex items-center justify-center flex-shrink-0 mt-1">
                <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                </svg>
              </div>
              <div>
                <h3 class="text-xl font-semibold text-white mb-2">Homeowner Focused</h3>
                <p class="text-gray-300 text-lg">
                  Every feature we build starts with one question: does this help homeowners save money and time? If the answer isn't a clear yes, we don't ship it.
                </p>
              </div>
            </div>
            <div class="flex items-start gap-6">
              <div class="w-12 h-12 bg-accent/10 rounded-full flex items-center justify-center flex-shrink-0 mt-1">
                <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                </svg>
              </div>
              <div>
                <h3 class="text-xl font-semibold text-white mb-2">Simplicity</h3>
                <p class="text-gray-300 text-lg">
                  Home management shouldn't require a manual. We design every screen to be intuitive and fast, so you spend less time in the app and more time enjoying your home.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Team Section -->
    <section class="py-20 bg-gray-800">
      <div class="container">
        <div class="max-w-4xl mx-auto text-center">
          <h2 class="text-3xl font-bold text-white mb-6">Built by Homeowners, for Homeowners</h2>
          <p class="text-lg text-gray-300 mb-8 max-w-2xl mx-auto">
            HavenKeep was born out of frustration. Our founding team lost thousands of dollars to expired warranties on appliances that were still covered. We knew there had to be a better way &mdash; so we built one.
          </p>
          <p class="text-lg text-gray-300 mb-12 max-w-2xl mx-auto">
            Today, our team of engineers, designers, and home-management experts is focused on one goal: making sure no homeowner ever pays out of pocket for something a warranty should cover.
          </p>
          <div class="grid sm:grid-cols-3 gap-8">
            <div class="bg-gray-900 border border-gray-700 rounded-xl p-6">
              <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
                <svg class="w-8 h-8 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                </svg>
              </div>
              <h3 class="text-white font-semibold mb-1">Engineering</h3>
              <p class="text-gray-400 text-sm">Building reliable, secure tools you can count on</p>
            </div>
            <div class="bg-gray-900 border border-gray-700 rounded-xl p-6">
              <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
                <svg class="w-8 h-8 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
                </svg>
              </div>
              <h3 class="text-white font-semibold mb-1">Design</h3>
              <p class="text-gray-400 text-sm">Crafting intuitive experiences that feel effortless</p>
            </div>
            <div class="bg-gray-900 border border-gray-700 rounded-xl p-6">
              <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
                <svg class="w-8 h-8 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z" />
                </svg>
              </div>
              <h3 class="text-white font-semibold mb-1">Support</h3>
              <p class="text-gray-400 text-sm">Real people ready to help when you need it</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-20 bg-gradient-to-br from-primary to-secondary">
      <div class="container">
        <div class="max-w-3xl mx-auto text-center text-white">
          <h2 class="text-4xl font-bold mb-6">
            Ready to protect your home investment?
          </h2>
          <p class="text-xl text-white/90 mb-8">
            Get HavenKeep on your phone and stop letting warranties expire unnoticed.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="/#download-hero" class="bg-white text-primary hover:bg-gray-100 font-semibold py-4 px-8 rounded-lg transition-colors duration-200 text-lg">
              Get the App
            </a>
            <a href="/pricing" class="bg-white/10 hover:bg-white/20 text-white border-2 border-white font-semibold py-4 px-8 rounded-lg transition-colors duration-200 text-lg">
              View Pricing
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
