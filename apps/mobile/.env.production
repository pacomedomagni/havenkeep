# Production Environment Configuration

API_BASE_URL=https://api.havenkeep.io

# Loki URL for centralized logging (set at deploy time)
LOKI_URL=

# RevenueCat (In-App Purchases) — required in production
REVENUECAT_API_KEY=
OUTLOOK_CLIENT_ID=
OUTLOOK_TENANT=common
OUTLOOK_REDIRECT_URI=

# Social Sign-In (Google + Apple)
# Web OAuth client ID from your Firebase project's linked Cloud project.
# Mobile passes this as serverClientId; backend verifies idToken aud against it.
GOOGLE_SERVER_CLIENT_ID=

# Apple Sign-In on Android / web — set per-environment so staging and prod
# each use their own Services ID + return URL configured in Apple Developer.
APPLE_SERVICES_ID=
APPLE_REDIRECT_URI=

# Marketing + support contact for production.
APP_URL=https://havenkeep.com
SUPPORT_EMAIL=support@havenkeep.com

# Gmail OAuth redirect for the email scanner.
GMAIL_REDIRECT_URI=https://api.havenkeep.com/auth/google/callback

# Firebase config — production project's GoogleService-Info.plist /
# google-services.json supplies these at build time.
FIREBASE_IOS_API_KEY=
FIREBASE_IOS_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_IOS_BUNDLE_ID=app.havenkeep.mobile
