# Development Environment Configuration
# Points to local Express API

API_BASE_URL=http://127.0.0.1:3000

# Loki is optional in development (logs are local)
# LOKI_URL=http://localhost:3100

# RevenueCat (In-App Purchases)
# Use your RevenueCat public SDK key for the Apple/Google app
REVENUECAT_API_KEY=
OUTLOOK_CLIENT_ID=
OUTLOOK_TENANT=common
OUTLOOK_REDIRECT_URI=

# Social Sign-In (Google + Apple)
# Web OAuth client ID from your Firebase project's linked Cloud project.
# Mobile passes this as serverClientId; backend verifies idToken aud against it.
GOOGLE_SERVER_CLIENT_ID=452180570234-i7olfif08g9ij3ta27nm5ds4j9650oeb.apps.googleusercontent.com

# Apple Sign-In on Android / web — set per-environment so staging and prod
# each use their own Services ID + return URL configured in Apple Developer.
APPLE_SERVICES_ID=
APPLE_REDIRECT_URI=

# Marketing site + support contact. environment_config.dart falls back to
# `havenkeep.app` (wrong TLD) if APP_URL is missing — set explicitly here.
APP_URL=http://localhost:4321
SUPPORT_EMAIL=support@havenkeep.com

# Gmail OAuth redirect for the email scanner (matches the URI registered
# in the Google Cloud OAuth client for this environment).
GMAIL_REDIRECT_URI=http://127.0.0.1:8080/auth/google/callback

# Firebase config — when blank, GoogleService-Info.plist /
# google-services.json supplies these values at build time. Override via
# env only if you can't ship the platform Firebase config files.
FIREBASE_IOS_API_KEY=
FIREBASE_IOS_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_IOS_BUNDLE_ID=app.havenkeep.mobile
