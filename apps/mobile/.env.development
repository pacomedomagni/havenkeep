# Development Environment Configuration
# Points to local Express API

API_BASE_URL=http://127.0.0.1:3000

# Loki is optional in development (logs are local)
# LOKI_URL=http://localhost:3100

# RevenueCat (In-App Purchases)
# Use your RevenueCat public SDK key for the Apple/Google app
REVENUECAT_API_KEY=
OUTLOOK_CLIENT_ID=
OUTLOOK_TENANT=common
OUTLOOK_REDIRECT_URI=

# Social Sign-In (Google + Apple)
# Web OAuth client ID from your Firebase project's linked Cloud project.
# Mobile passes this as serverClientId; backend verifies idToken aud against it.
GOOGLE_SERVER_CLIENT_ID=

# Apple Sign-In on Android / web — set per-environment so staging and prod
# each use their own Services ID + return URL configured in Apple Developer.
APPLE_SERVICES_ID=
APPLE_REDIRECT_URI=
