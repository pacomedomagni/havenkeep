# Staging Environment Configuration

API_BASE_URL=https://api.staging.havenkeep.app

# Loki (centralized logging, optional)
LOKI_URL=

# RevenueCat (In-App Purchases)
REVENUECAT_API_KEY=
OUTLOOK_CLIENT_ID=
OUTLOOK_TENANT=common
OUTLOOK_REDIRECT_URI=

# Social Sign-In (Google + Apple)
# Web OAuth client ID from your Firebase project's linked Cloud project.
# Mobile passes this as serverClientId; backend verifies idToken aud against it.
GOOGLE_SERVER_CLIENT_ID=452180570234-i7olfif08g9ij3ta27nm5ds4j9650oeb.apps.googleusercontent.com

# Apple Sign-In on Android / web — set per-environment so staging and prod
# each use their own Services ID + return URL configured in Apple Developer.
APPLE_SERVICES_ID=
APPLE_REDIRECT_URI=

# Marketing + support contact for staging.
APP_URL=https://staging.havenkeep.app
SUPPORT_EMAIL=support@havenkeep.com

# Gmail OAuth redirect for the email scanner.
GMAIL_REDIRECT_URI=https://api.staging.havenkeep.app/auth/google/callback

# Firebase config — same as dev. The staging Firebase project's
# GoogleService-Info.plist / google-services.json supplies these.
FIREBASE_IOS_API_KEY=
FIREBASE_IOS_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_IOS_BUNDLE_ID=app.havenkeep.mobile
