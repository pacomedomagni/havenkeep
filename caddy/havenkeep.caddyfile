# ═══════════════════════════════════════════════════════════════
# HAVENKEEP — Staging
# ═══════════════════════════════════════════════════════════════
# Append this to Loni's Caddyfile:
#   docker exec loni-caddy-1 cat /etc/caddy/Caddyfile  (to see current)
#   Then add these blocks and reload:
#   docker exec loni-caddy-1 caddy reload --config /etc/caddy/Caddyfile

# HavenKeep API
api.havenkeep.kouakoudomagni.com {
    log {
        output file /var/log/caddy/havenkeep-api.log {
            roll_size 50mb
            roll_keep 3
            roll_keep_for 720h
        }
        format json
    }

    reverse_proxy havenkeep-stg-api:3000 {
        health_uri /health
        health_interval 30s
        health_timeout 10s
        health_status 2xx

        transport http {
            dial_timeout 5s
            response_header_timeout 30s
            read_timeout 60s
            write_timeout 60s
        }

        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        -Server
    }
}

# HavenKeep Partner Dashboard
partner.havenkeep.kouakoudomagni.com {
    log {
        output file /var/log/caddy/havenkeep-dashboard.log {
            roll_size 50mb
            roll_keep 3
            roll_keep_for 720h
        }
        format json
    }

    reverse_proxy havenkeep-stg-dashboard:3001 {
        transport http {
            dial_timeout 5s
            response_header_timeout 30s
        }
    }

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        -Server
    }
}

# HavenKeep Marketing Site
havenkeep.kouakoudomagni.com {
    log {
        output file /var/log/caddy/havenkeep-marketing.log {
            roll_size 50mb
            roll_keep 3
            roll_keep_for 720h
        }
        format json
    }

    reverse_proxy havenkeep-stg-marketing:80 {
        transport http {
            dial_timeout 5s
            response_header_timeout 30s
        }
    }

    # Apple Universal Links: AASA MUST be served as application/json with no
    # extension on the path. The static host returns text/plain by default.
    @aasa path /.well-known/apple-app-site-association
    header @aasa Content-Type application/json

    # Android App Links: assetlinks.json already gets the right type from
    # the .json extension, but pin it explicitly so a future content-type
    # override can't break Play's verifier.
    @assetlinks path /.well-known/assetlinks.json
    header @assetlinks Content-Type application/json

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        # Audit W078 / W111: enforce CSP at the edge so the static Astro
        # build doesn't have to embed it in every page. Tight enough to
        # block inline-script injection while still allowing Astro's
        # hydration islands. `strict-dynamic` lets only scripts loaded by
        # an already-trusted script run.
        Content-Security-Policy "default-src 'self'; script-src 'self' 'strict-dynamic'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://api.havenkeep.kouakoudomagni.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        -Server
    }
}
